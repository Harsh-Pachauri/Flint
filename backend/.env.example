# ===== DATABASE CONFIGURATION =====
# MongoDB connection string
# Local MongoDB: mongodb://localhost:27017/dating_app
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dating_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dating_app

# ===== JWT CONFIGURATION =====
# Secret keys for JWT token signing (use strong, random strings)
JWT_SECRET=your_super_secret_jwt_key_change_this_12345678
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_this_12345678

# ===== CLOUDINARY CONFIGURATION (Optional) =====
# Get from: https://cloudinary.com/console
# If not provided, local file storage will be used
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ===== SERVER CONFIGURATION =====
PORT=5000
NODE_ENV=development

# Frontend URL for CORS and WebSocket
FRONTEND_URL=http://localhost:3000

# ===== EMAIL CONFIGURATION (Optional - for password reset) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password_here
# SMTP_FROM=noreply@datingapp.com

# ===== LOGGING =====
LOG_LEVEL=debug

